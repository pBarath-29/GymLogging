rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only touch their own profile doc, days, templates and photos
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Collections shared by link. Any signed-in user who has the link can open one;
    // nobody can browse other people's, and a shared copy can't be edited after it's made.
    match /shared/{id} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.groups is list
                    && request.resource.data.groups.size() <= 20;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
